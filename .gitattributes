# Normalisation des fins de ligne : LF dans le depot, conversion auto selon l'OS
* text=auto

# Forcer LF pour les fichiers texte Python et web
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Jeux de donnees : aucune conversion de fin de ligne, sinon leur empreinte
# SHA256 changerait entre Windows et Linux.
*.csv -text
*.sha256 -text

# Fichiers binaires : pas de conversion
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.docx binary
